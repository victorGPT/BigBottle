PORT=4000
CORS_ORIGIN=http://localhost:5173

# Used to sign API access tokens (JWT)
JWT_SECRET=change-me-change-me

# Supabase (DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AWS
AWS_REGION=
S3_BUCKET=
# If you are not using an IAM role / instance profile, set static credentials for local dev:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Receipt analyzer
# - dify: call the existing Dify workflow path
# - temporal: start a Temporal workflow and wait for its result
RECEIPT_ANALYZER_PROVIDER=dify

# Dify
# - mock: return a fixture response (local dev / tests)
# - workflow: call Dify Workflow API
DIFY_MODE=mock
# Dify workflow image input is configured as a file input.
# The API passes a remote URL payload:
#   { type: "image", transfer_method: "remote_url", url: "<presigned-get-url>" }
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=
DIFY_IMAGE_INPUT_KEY=image_url
# Dify call timeout in milliseconds
DIFY_TIMEOUT_MS=20000

# Temporal receipt analyzer
# Used when RECEIPT_ANALYZER_PROVIDER=temporal.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=bigbottle-receipt-verification
TEMPORAL_WORKFLOW_TYPE=receiptVerificationWorkflow
TEMPORAL_WORKFLOW_TIMEOUT_MS=20000
# Set true for Temporal Cloud or a TLS-enabled AWS deployment.
TEMPORAL_TLS=false
# Optional for Temporal Cloud API-key auth.
TEMPORAL_API_KEY=

# Dify-compatible HTTP bridge. It starts the Temporal worker in-process and
# exposes POST /v1/workflows/run for the existing Supabase Edge Function path.
ANALYZER_BRIDGE_PORT=8084
# Optional. If set, requests must send Authorization: Bearer <key>.
ANALYZER_BRIDGE_API_KEY=

# Receipt model provider used by the Temporal receipt worker.
# - gemini: Google Gemini generateContent
# - siliconflow: SiliconFlow OpenAI-compatible chat completions
RECEIPT_MODEL_PROVIDER=gemini

# Gemini vision model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_IMAGE_BYTES=10485760
RECEIPT_MODEL_IMAGE_MAX_LONG_EDGE=1024
RECEIPT_MODEL_IMAGE_JPEG_QUALITY=78

# SiliconFlow OpenAI-compatible model.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TIMEOUT_MS=30000

# Presign TTL in seconds
S3_PRESIGN_EXPIRES_SECONDS=300

# --- Phase 2 (Rewards / On-chain B3TR claim) ---
# Rewards mode:
# - chain: sign & broadcast delegated transactions (VIP-191 + sponsor URL)
# - mock: no chain calls; useful for local UI/API testing
REWARDS_MODE=chain

# Network: testnet or mainnet
VECHAIN_NETWORK=testnet
# Optional override. Defaults:
# - testnet: https://testnet.vechain.org
# - mainnet: https://mainnet.vechain.org
VECHAIN_NODE_URL=

# VeBetterDAO app id (bytes32 hex, 0x...)
VEBETTER_APP_ID=
# X2EarnRewardsPool address (per network).
X2EARN_REWARDS_POOL_ADDRESS=

# Fee delegation (VIP-191) sponsor URL (vechain.energy or your own gas payer service).
FEE_DELEGATION_URL=

# Reward distributor private key (0x...) for X2EarnRewardsPool distribution calls.
REWARD_DISTRIBUTOR_PRIVATE_KEY=

# Optional: lock vote bonus eligibility lookup to a specific effective round.
# If omitted, /account/achievements can still override via query param.
# Example: 42
VEBETTER_CURRENT_EFFECTIVE_ROUND_ID=
