# BigBottle function env vars for self-hosted Supabase.
# Fill these on the AWS host. Do not commit real values.

JWT_SECRET=
BB_SUPABASE_URL=https://<aws-supabase-domain>
BB_SUPABASE_SERVICE_ROLE_KEY=

AWS_REGION=ap-northeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRES_SECONDS=300

RECEIPT_ANALYZER_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TIMEOUT_MS=30000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_IMAGE_BYTES=10485760

DIFY_MODE=workflow
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=
DIFY_IMAGE_INPUT_KEY=image_url
DIFY_TIMEOUT_MS=20000

REWARDS_MODE=chain
VECHAIN_NETWORK=mainnet
VECHAIN_NODE_URL=
VEBETTER_APP_ID=
X2EARN_REWARDS_POOL_ADDRESS=
FEE_DELEGATION_URL=
REWARD_DISTRIBUTOR_PRIVATE_KEY=

VEBETTER_CURRENT_EFFECTIVE_ROUND_ID=
VECHAIN_THOR_URL=
VEBETTER_GALAXY_MEMBER_ADDRESS=
TURNSTILE_SECRET_KEY=
